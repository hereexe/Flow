<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base App / Window Tokens (Whisper Pill Light) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="InsetHighlightBrush" Color="#80FFFFFF" />
    
    <SolidColorBrush x:Key="TextMainBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="WindowControlBrush" Color="#FF64748B" />
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FF94A3B8" />

    <!-- Dropdown / Popup Tokens -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#FFE2E8F0" />
    
    <!-- HUD Tokens -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="HudBorderBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="HudTextBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="HudTextSuccessBrush" Color="#FF059669" />
    <SolidColorBrush x:Key="HudTextErrorBrush" Color="#FFDC2626" />
    
    <SolidColorBrush x:Key="HudDotActiveBrush" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="HudDotSuccessBrush" Color="#FF10B981" />
    <SolidColorBrush x:Key="HudDotErrorBrush" Color="#FFEF4444" />
    
    <Color x:Key="HudShadowColor">#30000000</Color>

    <!-- Corner Radii -->
    <CornerRadius x:Key="WindowCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="HudCornerRadius">100</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ToggleCornerRadius">10</CornerRadius>
</ResourceDictionary>
