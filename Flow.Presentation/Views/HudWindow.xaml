<Window x:Class="Flow.Presentation.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow HUD" Height="64" Width="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        IsHitTestVisible="False" FontFamily="Segoe UI">
    <Border x:Name="ContainerBorder" Background="#1e293b" CornerRadius="30" Padding="24,12" 
            BorderBrush="Transparent" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="GlowEffect" ShadowDepth="0" BlurRadius="20" Color="#000000" Opacity="0" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Spinner -->
            <Border x:Name="Spinner" Width="18" Height="18" Margin="0,0,12,0" 
                    BorderThickness="3,3,3,0" BorderBrush="#3b82f6" 
                    CornerRadius="9" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="SpinnerStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1" 
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinnerStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <RotateTransform CenterX="9" CenterY="9" />
                </Border.RenderTransform>
            </Border>
            
            <!-- Success Icon -->
            <TextBlock x:Name="SuccessIcon" Text="✔" FontWeight="Bold" 
                       Foreground="#10b981" FontSize="16" Margin="0,0,12,0" 
                       VerticalAlignment="Center" Visibility="Collapsed"/>
                       
            <!-- Error Icon -->
            <TextBlock x:Name="ErrorIcon" Text="✖" FontWeight="Bold" 
                       Foreground="#ef4444" FontSize="16" Margin="0,0,12,0" 
                       VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- Message Text -->
            <TextBlock x:Name="MessageText" Foreground="White" 
                       FontWeight="Medium" FontSize="15" 
                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Text="Translating..."/>
        </StackPanel>
    </Border>
</Window>
