<Window x:Class="Flow.Presentation.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow HUD"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        FontFamily="Segoe UI, Inter"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- pulse 1.5s ease-in-out infinite → Opacity 1.0 ↔ 0.4, 0.75s per half, AutoReverse -->
        <Storyboard x:Key="DotPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4"
                             Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Margin for shadow bleed space -->
    <Grid Margin="12">
        <!-- 
             CSS: background: rgba(22,24,36,.85)   → #D9161824
                  border: 1px solid rgba(255,255,255,.06) → #0FFFFFFF
                  border-radius: 100px              → CornerRadius="100"
                  box-shadow: 0 4px 20px rgba(0,0,0,.45)  → DropShadowEffect
        -->
        <Border x:Name="ContainerBorder"
                Background="#D9161824"
                BorderBrush="#0FFFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <!-- box-shadow: 0 4px 20px rgba(0,0,0,.45) -->
                <DropShadowEffect BlurRadius="20"
                                  Color="Black"
                                  Opacity="0.45"
                                  ShadowDepth="4"
                                  Direction="270"/>
            </Border.Effect>

            <!-- 
                 CSS inset: inset 0 0.5px 0 rgba(255,255,255,.08) → #14FFFFFF top border
                 CSS padding: 7px 18px 7px 10px → Padding="10,7,18,7"
            -->
            <Border CornerRadius="16"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="10,0,18,0">
                <!-- CSS: display:inline-flex; align-items:center; gap:8px -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- 
                         CSS .hud-dot: width:8px; height:8px; border-radius:50%;
                              background: var(accent-blue) = #4d8ef7
                              animation: pulse 1.5s ease-in-out infinite
                         gap:8px → Margin="0,0,8,0"
                    -->
                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             Fill="#FF4D8EF7"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <!-- 
                         CSS .hud-text: color:#8892ac; font-size:12px; font-weight:500; letter-spacing:-0.1px
                    -->
                    <TextBlock x:Name="MessageText"
                               Text="Translating…"
                               Foreground="#FF8892AC"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
